<Window x:Class="Remi.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:character="clr-namespace:Remi.Desktop.Character"
        Title="Rémi · Settings" Width="460" Height="700" MinWidth="420" MinHeight="520" Background="{DynamicResource Paper}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True">
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="A companion, your way." FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Small details. A little more you." Foreground="{DynamicResource Muted}" Margin="0,5,0,0" /></StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,12,0,0">
      <TabItem Header="Companion"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,0,12,0">
        <TextBlock Text="Character" Margin="0,0,0,6" />
        <ComboBox x:Name="CharacterBox" SelectionChanged="PreviewChanged" AutomationProperties.Name="Companion style"><ComboBoxItem Content="Professional" /><ComboBoxItem Content="Cute Rémi" /><ComboBoxItem Content="Robot" /></ComboBox>
        <Border Background="{DynamicResource Subtle}" CornerRadius="12" Margin="0,12,0,0"><character:KoalaVisual x:Name="PreviewCharacter" Width="150" Height="160" Margin="0,8" /></Border>
        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
        <Grid x:Name="ClothingOptions"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Coat" Margin="0,0,0,5" /><ComboBox x:Name="FurBox" SelectionChanged="PreviewChanged"><ComboBoxItem Content="Eucalyptus grey" /><ComboBoxItem Content="Warm amber" /><ComboBoxItem Content="Midnight" /></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Outfit" Margin="0,0,0,5" /><ComboBox x:Name="OutfitBox" SelectionChanged="PreviewChanged"><ComboBoxItem Content="Signature look" /><ComboBoxItem Content="Everyday tee" /><ComboBoxItem Content="Hawaiian shirt" /><ComboBoxItem Content="Tuxedo" /></ComboBox></StackPanel>
        </Grid>
        <CheckBox x:Name="GlassesBox" Content="A pair of sunglasses" Click="PreviewChanged" Margin="0,16,0,8" />
        <DockPanel Margin="0,8,0,5"><TextBlock Text="Desktop size" /><TextBlock Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" /></DockPanel>
        <Slider x:Name="SizeSlider" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="PreviewChanged" AutomationProperties.Name="Desktop size" />
        <CheckBox x:Name="MotionBox" Content="Reduce motion" Click="PreviewChanged" Margin="0,18,0,8" />
        <TextBlock Text="Rémi rests when idle. Reduce motion also turns off blinking and expressive movement." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="17" />
        <TextBlock Text="APPLICATION THEME" Style="{StaticResource SectionLabel}" />
        <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged" AutomationProperties.Name="Application theme"><ComboBoxItem Content="Eucalyptus" /><ComboBoxItem Content="Slate" /><ComboBoxItem Content="Midnight" /></ComboBox>
        <TextBlock Text="Custom colors (optional)" Margin="0,12,0,6" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Accent · #RRGGBB" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="AccentBox" TextChanged="ThemeChanged" MaxLength="7" AutomationProperties.Name="Custom accent color" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Background · #RRGGBB" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="BackgroundBox" TextChanged="ThemeChanged" MaxLength="7" AutomationProperties.Name="Custom background color" /></StackPanel>
        </Grid>
        <Button Content="Reset custom colors" Click="ResetColorsClick" HorizontalAlignment="Left" Margin="0,10,0,12" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Connection"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,0,12,0">
        <TextBlock Text="AI provider" Margin="0,0,0,6" />
        <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderChanged" AutomationProperties.Name="AI provider"><ComboBoxItem Content="Ollama · local or remote" /><ComboBoxItem Content="OpenAI · ChatGPT models" /></ComboBox>
        <StackPanel x:Name="OllamaPanel">
        <TextBlock Text="OLLAMA" Style="{StaticResource SectionLabel}" />
        <TextBlock Text="Host address" Margin="0,0,0,6" /><TextBox x:Name="HostBox" AutomationProperties.Name="Ollama host" />
        <TextBlock Text="Use a local Ollama server or your own remote host. Cloud models can also run through your local Ollama installation." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,16" LineHeight="17" />
        <TextBlock Text="Model" Margin="0,0,0,6" /><ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="Ollama model" />
        <Button x:Name="RefreshButton" Content="Refresh available models" Click="RefreshClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
        <TextBlock Text="RESOURCE USE" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="UnloadBox" Content="Release the model after each reply" />
        <TextBlock Text="Frees Ollama's model memory between conversations. Replies may take longer to start. Turn this off to keep the model warm for five minutes." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="17" />
        </StackPanel>
        <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed">
          <TextBlock Text="OPENAI" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="API key" Margin="0,0,0,6" /><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="OpenAI API key" />
          <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0" />
          <Button Content="Remove saved key" Click="RemoveKeyClick" HorizontalAlignment="Left" Margin="0,8,0,12" />
          <TextBlock Text="Model" Margin="0,0,0,6" /><ComboBox x:Name="OpenAiModelBox" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="OpenAI model" />
          <Button x:Name="OpenAiRefreshButton" Content="Refresh available models" Click="RefreshClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <TextBlock Text="Uses an OpenAI API key. API usage is billed separately from ChatGPT subscriptions. Your saved key is encrypted for your Windows account." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="17" Margin="0,16,0,0" />
        </StackPanel>
        <Border Background="{DynamicResource Subtle}" CornerRadius="10" Padding="14" Margin="0,24,0,0"><StackPanel><TextBlock Text="Your connection, your choice" FontWeight="SemiBold" /><TextBlock Text="Chat stays in memory. Messages go to your selected provider. Switching providers starts a fresh conversation. Remote services follow their provider's policies." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="17" Margin="0,6,0,0" /></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Voice"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,0,12,0">
        <TextBlock Text="SPEAKING" Style="{StaticResource SectionLabel}" /><CheckBox x:Name="SpeechBox" Content="Read replies aloud" />
        <TextBlock Text="Windows voice" Margin="0,6,0,6" /><ComboBox x:Name="VoiceBox" AutomationProperties.Name="Windows voice" />
        <Button Content="Add voices in Windows" Click="AddVoicesClick" HorizontalAlignment="Left" FontSize="11" Margin="0,8,0,12" />
        <DockPanel><TextBlock Text="Speaking speed" /><TextBlock Text="{Binding ElementName=RateSlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" /></DockPanel>
        <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" AutomationProperties.Name="Speaking speed" />
        <TextBlock Text="LISTENING" Style="{StaticResource SectionLabel}" />
        <TextBlock Text="Microphone" Margin="0,0,0,6" /><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Microphone" />
        <TextBlock Text="Python executable" Margin="0,14,0,6" /><TextBox x:Name="PythonBox" AutomationProperties.Name="Python executable" />
        <TextBlock Text="Whisper model" Margin="0,14,0,6" /><ComboBox x:Name="WhisperBox" AutomationProperties.Name="Whisper model"><ComboBoxItem Content="tiny" /><ComboBoxItem Content="base" /><ComboBoxItem Content="small" /></ComboBox>
        <TextBlock Text="Voice input uses local Whisper, only when you press record. Install with: python -m pip install openai-whisper. The first recording downloads the selected model. Tiny uses the fewest resources. Recordings are deleted after transcription." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="17" Margin="0,12,0,12" />
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelClick" Margin="0,0,8,0" IsCancel="True" /><Button x:Name="SaveChangesButton" Content="Save changes" Click="SaveClick" Style="{StaticResource PrimaryButton}" IsDefault="True" /></StackPanel>
  </Grid>
</Window>
