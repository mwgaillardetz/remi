<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Remi</AssemblyName>
    <RootNamespace>Remi.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\remi.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Description>A quiet, native desktop companion.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Remi.Core\Remi.Core.csproj" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <Resource Include="Assets\remi.ico" />
    <Content Include="Voice\transcribe.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
