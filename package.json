{
  "name": "remi",
  "version": "2.0.0",
  "private": true,
  "description": "A native Windows koala companion with local AI and a lighter footprint",
  "license": "MIT",
  "scripts": {
    "start": "dotnet run --project native/Remi.Desktop -c Release",
    "build": "dotnet build Remi.slnx -c Release",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1",
    "test:core": "dotnet run --project tests/Remi.Core.Tests -c Release",
    "test:voice": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-voice.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark.ps1"
  }
}
